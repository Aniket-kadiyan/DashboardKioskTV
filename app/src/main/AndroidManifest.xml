<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.DashboardKioskTV">

        <activity
            android:name=".PlayerActivity"
            android:exported="false"
            android:lockTaskMode="if_whitelisted"
            android:screenOrientation="landscape" />

        <activity
            android:name=".PlaylistActivity"
            android:exported="false"
            android:lockTaskMode="if_whitelisted"
            android:screenOrientation="landscape" />

        <activity
            android:name=".AdminMenuActivity"
            android:exported="false"
            android:lockTaskMode="if_whitelisted"
            android:screenOrientation="landscape" />

        <activity
            android:name=".SettingsMenuActivity"
            android:exported="false"
            android:lockTaskMode="if_whitelisted"
            android:screenOrientation="landscape" />

        <activity
            android:name=".ChangePinActivity"
            android:exported="false"
            android:lockTaskMode="if_whitelisted"
            android:screenOrientation="landscape" />

        <activity
            android:name=".PinSetupActivity"
            android:exported="false"
            android:screenOrientation="landscape" />
        <activity
            android:name=".DashboardPageEditorActivity"
            android:exported="false"
            android:lockTaskMode="if_whitelisted"
            android:screenOrientation="landscape" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape">


            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>

        </activity>

        <receiver
            android:name=".kiosk.KioskDeviceAdminReceiver"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_DEVICE_ADMIN">

            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin_receiver" />

            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>

        </receiver>

    </application>
</manifest>