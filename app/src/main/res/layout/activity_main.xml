<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101010">

    <LinearLayout
        android:id="@+id/adminPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="32dp"
        android:background="#101010">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Dashboard Kiosk Playlist"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:paddingBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enter one dashboard per line in this format:"
            android:textColor="#CCCCCC"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Title | URL | Seconds"
            android:textColor="#999999"
            android:textSize="14sp"
            android:paddingBottom="16dp" />

        <EditText
            android:id="@+id/playlistInput"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="top|start"
            android:inputType="textMultiLine|textUri"
            android:singleLine="false"
            android:textColor="#FFFFFF"
            android:textColorHint="#777777"
            android:background="#202020"
            android:padding="16dp"
            android:textSize="16sp"
            android:hint="Production | https://example.com | 30&#10;Quality | https://www.wikipedia.org | 20" />

        <CheckBox
            android:id="@+id/loopCheckbox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Loop playlist continuously"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:checked="true"
            android:paddingTop="16dp"
            android:paddingBottom="16dp" />

        <Button
            android:id="@+id/startButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save and Start Display"
            android:textSize="18sp" />

    </LinearLayout>

    <WebView
        android:id="@+id/dashboardWebView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

</FrameLayout>