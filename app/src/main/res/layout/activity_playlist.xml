<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/playlistRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:padding="24dp"
    android:background="#101010">

    <!-- LEFT: main playlist area -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingEnd="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Manage Playlist"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:textStyle="bold"
            android:paddingBottom="4dp" />

        <TextView
            android:id="@+id/helpText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select an item to edit, delete, or reorder."
            android:textColor="#BBBBBB"
            android:textSize="15sp"
            android:paddingBottom="12dp" />

        <ListView
            android:id="@+id/playlistListView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:choiceMode="singleChoice"
            android:background="#202020"
            android:divider="#444444"
            android:dividerHeight="1dp"
            android:listSelector="#3A4A5A" />

    </LinearLayout>

    <!-- RIGHT: compact actions area -->
    <!-- RIGHT: scrollable compact actions area -->
    <ScrollView
        android:layout_width="270dp"
        android:layout_height="match_parent"
        android:background="#181818"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Actions"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"
                android:paddingBottom="12dp" />

            <Button
                android:id="@+id/addButton"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="Add"
                android:textSize="14sp" />

            <Button
                android:id="@+id/editButton"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:text="Edit"
                android:textSize="14sp" />

            <Button
                android:id="@+id/deleteButton"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:text="Delete"
                android:textSize="14sp" />

            <Button
                android:id="@+id/moveUpButton"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:text="Move Up"
                android:textSize="14sp" />

            <Button
                android:id="@+id/moveDownButton"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:text="Move Down"
                android:textSize="14sp" />

            <CheckBox
                android:id="@+id/loopCheckbox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Loop playlist"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:checked="true"
                android:paddingTop="14dp"
                android:paddingBottom="10dp" />

            <Button
                android:id="@+id/saveButton"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="12dp"
                android:text="Save"
                android:textSize="15sp" />

            <Button
                android:id="@+id/startButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:text="Save &amp; Start"
                android:textSize="15sp" />

            <Button
                android:id="@+id/backButton"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="10dp"
                android:text="Back"
                android:textSize="15sp" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>